MISTRAL_API_KEY=your_mistral_api_key_here
# Optional. Free-tier friendly default; mistral-small-latest may have a 0 req/min quota on free accounts.
MISTRAL_MODEL=ministral-8b-latest
# Optional. Model for the "Generate letter" button. ministral-14b-latest (free tier, 30 req/min) writes richer letters;
# if it fails the letter falls back to MISTRAL_MODEL.
# MISTRAL_LETTER_MODEL=ministral-14b-latest
# Optional. "classic" = use the original spinner loading screen instead of the orbit screen.
# NEXT_PUBLIC_ANALYZING_SCREEN=classic
# Interview practice (BETA), see docs/interview-agent-prompt.md. Without the agent id the screen runs in text-only mode.
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_...
# Only for a PRIVATE agent (server side, never commit it):
# ELEVENLABS_API_KEY=...
